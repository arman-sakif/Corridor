# Supabase — Project settings > API keys
#
# The publishable key is safe in the browser: RLS is what protects the data
# behind it. The secret key bypasses RLS entirely and is server-only.
# (These were called the anon key and the service_role key until recently;
# both old names are still read as a fallback.)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Never expose this to the client bundle.
SUPABASE_SECRET_KEY=sb_secret_...

# Resend — transactional email. Leave the key unset in development: notify()
# falls back to logging the message instead of sending it, which is how you
# read a sign-in code without an inbox.
#
# The from-address must be on a domain verified at resend.com/domains, or every
# send is refused with a 403. Until one is, the only usable sender is Resend's
# sandbox — and it delivers ONLY to the address the Resend account was opened
# with, so account recovery does not reach real passengers until a domain is
# verified and this is changed.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=Corridor <onboarding@resend.dev>

# Absolute origin, used in email links and the OAuth redirect.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for the daily housekeeping route (/api/cron). Vercel Cron sends
# it as a bearer token. Without it the route returns 404 and does nothing.
CRON_SECRET=

# One phone number, one account. Off by default so several test accounts can
# share a number and an inbox; set to 1 once the demo accounts are gone.
ENFORCE_UNIQUE_CONTACT=
