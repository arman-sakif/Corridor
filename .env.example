# Supabase — project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose this to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend — transactional email. Leave unset in development: notify() falls back
# to logging the message instead of sending it.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=Corridor <noreply@example.com>

# Absolute origin, used in email links and the OAuth redirect.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for the daily housekeeping route (/api/cron). Vercel Cron sends
# it as a bearer token. Without it the route returns 404 and does nothing.
CRON_SECRET=
